# Default mode runs the existing local order preview. Use test before live.
COMMERCE_MODE=preview

# Public browser configuration for Supabase email sign-in.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only settings. Set COMMERCE_ORIGIN=https://soulbites.in in production.
COMMERCE_ORIGIN=http://localhost:3000
SUPABASE_URL=
SUPABASE_SECRET_KEY=
COMMERCE_ACCESS_SECRET=
# Optional customer PIN allowlist with a radius. Required for PIN-only testing.
COMMERCE_DELIVERY_PINS=

# Production requires all four radius settings. In test mode, leave all four
# empty for PIN-only testing or set all four for full delivery-area testing.
COMMERCE_DELIVERY_RADIUS_METRES=
COMMERCE_KITCHEN_LATITUDE=
COMMERCE_KITCHEN_LONGITUDE=
GOOGLE_GEOCODING_API_KEY=

# Set amounts in paise and tax in basis points. See docs/ORDERING.md for test values.
COMMERCE_MINIMUM_PAISE=
COMMERCE_DELIVERY_PAISE=
COMMERCE_FREE_DELIVERY_PAISE=
COMMERCE_TAX_BPS=

COMMERCE_COD_ENABLED=true
COMMERCE_RAZORPAY_ENABLED=false

# Server-only. Leave empty when Razorpay is disabled.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
